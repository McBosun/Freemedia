# --- Storage: Cloudflare R2 (zero egress fees) ---
# Create 2 buckets in R2: raw-uploads (private) and hls (public via custom domain)
# R2 dashboard > Manage API tokens > create token with Object Read & Write
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
RAW_BUCKET=raw-uploads
HLS_BUCKET=hls

# --- Local MinIO fallback (use only with: --profile local-storage) ---
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1

# Supabase pooler: user is postgres.<POOLER_TENANT_ID> (default tenant: your-tenant-id)
DB_URL=postgresql://postgres.your-tenant-id:YOUR_POSTGRES_PASSWORD@host.docker.internal:5432/postgres
# (uploader reuses the S3_* and HLS_BUCKET values above)
